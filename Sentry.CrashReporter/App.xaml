<Application x:Class="Sentry.CrashReporter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Fonts.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Images.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#89BD24</Color>
            <Color x:Key="SystemAccentColorLight1">#9BC745</Color>
            <Color x:Key="SystemAccentColorLight2">#79A620</Color>
            <Color x:Key="SystemAccentColorLight3">#ACD166</Color>
            <Color x:Key="SystemAccentColorDark1">#79A620</Color>
            <Color x:Key="SystemAccentColorDark2">#608419</Color>
            <Color x:Key="SystemAccentColorDark3">#455F12</Color>

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#222226" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#222226" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#222226" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#222226" Opacity="0.75" />

            <x:String x:Key="WindowTitle">IW4x Crash Reporter</x:String>
            <x:Boolean x:Key="WindowClosable">True</x:Boolean>
            <x:String x:Key="HeaderText">IW4x crashed</x:String>
            <x:String x:Key="HeaderDescription">You can send this report to the IW4x developers to help them fix the problem. Nothing is sent unless you select Submit.</x:String>
            <x:String x:Key="CancelButton">Cancel</x:String>
            <x:String x:Key="SubmitButton">Submit</x:String>

            <!-- ReSharper disable Xaml.LanguageLevel -->
            <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
            <!-- ReSharper restore Xaml.LanguageLevel -->
            <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderChevronForeground" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ExpanderChevronPointerOverForeground" Color="{ThemeResource SystemColorButtonFaceColor}" Opacity="0.6" />
            <SolidColorBrush x:Key="ExpanderChevronPressedForeground" Color="{ThemeResource SystemColorButtonFaceColor}" Opacity="0.4" />
            <Style TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
                <!-- ReSharper disable once Xaml.DependencyPropertyResolveError -->
                <Setter Property="MinHeight" Value="{ThemeResource TextControlThemeMinHeight}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
